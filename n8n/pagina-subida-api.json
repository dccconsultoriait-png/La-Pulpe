{
  "name": "Multiredes: página de subida (API) v1.0",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "multiredes-api",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://dccconsultoriait-png.github.io"
        }
      },
      "name": "Pedido de la página",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "52c79e6f-3bfe-5f08-91a2-3e57c8c0b53e",
      "id": "ed3d4fa7-8681-5a0b-a0d3-7ac810b6e5ab",
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Lee lo que manda la página y arma la llamada a Supabase\nconst crudo = $json.body ?? {};\nlet b = crudo;\nif (typeof crudo === 'string') { try { b = JSON.parse(crudo); } catch (e) { b = {}; } }\nconst t = /^[0-9a-f-]{36}$/i.test(String(b.t || '')) ? String(b.t) : '00000000-0000-0000-0000-000000000000';\nconst accion = ['info', 'preparar', 'confirmar'].includes(b.accion) ? b.accion : 'info';\nconst origin = String(($json.headers || {}).origin || 'https://dccconsultoriait-png.github.io');\n\nlet rpc, cuerpo;\nif (accion === 'preparar') {\n  rpc = 'preparar_subida';\n  cuerpo = { p_token: t, p_tipo: String(b.tipo || ''), p_nota: String(b.nota || '').slice(0, 1000),\n             p_archivos: Array.isArray(b.archivos) ? b.archivos.slice(0, 10) : [] };\n} else if (accion === 'confirmar') {\n  rpc = 'confirmar_subida';\n  cuerpo = { p_token: t, p_pedido_id: /^[0-9a-f-]{36}$/i.test(String(b.pedido_id || '')) ? b.pedido_id : '00000000-0000-0000-0000-000000000000',\n             p_archivos: Array.isArray(b.archivos) ? b.archivos.slice(0, 10) : [] };\n} else {\n  rpc = 'pagina_cliente';\n  cuerpo = { p_token: t };\n}\nreturn [{ json: { accion, rpc, cuerpo, nota: String(b.nota || '').slice(0, 1000), origin } }];\n"
      },
      "name": "Leer pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "6da9ca1e-5d91-511a-b31d-59b36b6ebd77",
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://smmmbtmhcceivjipnfxe.supabase.co/rest/v1/rpc/{{ $json.rpc }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.cuerpo) }}",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Llamar a Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase account"
        }
      },
      "id": "6f95300f-8450-5818-ae3b-973826a04e11",
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "58518b9b-79cf-5d7a-aab6-f9a48e61a344",
              "leftValue": "={{ $('Leer pedido').item.json.accion === 'preparar' && $json.ok === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "¿Hay que abrir subidas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "id": "aea77e4d-11b9-56e5-9042-055847952036",
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Una subida en Drive por cada archivo del pedido\nconst r = $input.first().json;\nconst p = $('Leer pedido').first().json;\nreturn r.archivos.map(a => ({ json: {\n  nombre: a.nombre, mime: a.mime, tamano: a.tamano,\n  carpeta: r.carpeta_id, nota: p.nota, origin: p.origin,\n} }));\n"
      },
      "name": "Un ítem por archivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "55e79759-a065-587e-a965-947815d92dab",
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&supportsAllDrives=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Upload-Content-Type",
              "value": "={{ $json.mime }}"
            },
            {
              "name": "X-Upload-Content-Length",
              "value": "={{ String($json.tamano) }}"
            },
            {
              "name": "Origin",
              "value": "={{ $json.origin }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.nombre, parents: [$json.carpeta], description: $json.nota }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          },
          "timeout": 30000
        }
      },
      "name": "Abrir subida en Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive account"
        }
      },
      "id": "eea89b8b-335a-5f58-97ff-060e0051d377",
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Devuelve a la página adónde subir cada archivo\nconst r = $('Llamar a Supabase').first().json;\nconst subidas = $input.all();\nconst archivos = r.archivos.map((a, i) => {\n  const h = (subidas[i] && subidas[i].json.headers) || {};\n  return { nombre: a.nombre, url: h.location || h.Location || null };\n});\nif (archivos.some(a => !a.url)) {\n  return [{ json: { ok: false, error: 'No pude abrir la subida en Drive' } }];\n}\nreturn [{ json: { ok: true, pedido_id: r.pedido_id, archivos } }];\n"
      },
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "83c0bd4b-7d16-5acc-9ed3-5a1f2b91671c",
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "name": "Responder a la página",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "id": "fdbf019c-1014-5dc0-989d-3dd9db40bf57",
      "position": [
        1680,
        520
      ]
    }
